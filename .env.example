# Required in production. Use a unique value with at least 12 characters.
# Development only falls back to SOUL2026 when this variable is absent.
ADMIN_PASSWORD=

# Required in production. Generate at least 32 random characters, for example:
# openssl rand -base64 48
ADMIN_SESSION_SECRET=

# Recommended now; required when rate limiting moves to a shared store.
# Used only to pseudonymize the transient client-address bucket key.
RATE_LIMIT_SECRET=

# Reserved for the production opaque NFC URL signer described in ARCHITECTURE.md.
# It is intentionally unused by the static-token prototype.
NFC_SIGNING_SECRET=

# Supabase SSR configuration. Use the modern publishable/secret keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Canonical public URL used in metadata, auth redirects, and signed links.
NEXT_PUBLIC_SITE_URL=

# Optional: production NTAG 424 DNA SUN/SDM verification material.
NFC_SDM_MASTER_KEY=
NFC_SDM_FILE_READ_KEY=

# Optional outbound telemetry/error hook. Never include PII in payloads.
ERROR_WEBHOOK_URL=
