  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "npm run lint && npm run typecheck && npm run test:unit && npm run build",
    "test:unit": "node --test tests/**/*.test.mjs",
    "smoke": "node tests/smoke.mjs",
