    "@vercel/speed-insights": "2.0.0",
    "motion": "^12.42.2",
    "next": "^16.2.10",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.2.10",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
